# Port for the Vite dev server (default: 5173)
PORT=5173

# Port that the dev proxy should forward /api calls to (default: 5000, local dev only)
API_PORT=5000

# Set this when the frontend and API are deployed to different origins (e.g. Vercel + Railway).
# Leave blank when using the built-in Vite proxy or Replit's shared proxy.
# Example: VITE_API_URL=https://my-api.railway.app
VITE_API_URL=
